<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!-- Constants                                                 -->
  <!-- ========================================================= -->

  <xacro:property name="M_PI" value="3.1415926535897931"/>


  <!-- ========================================================= -->
  <!-- Camera mounting                                          -->
  <!-- ========================================================= -->

  <joint name="sim_camera_joint" type="fixed">

    <parent link="base_link"/>
    <child link="sim_camera_link"/>

    <origin
      xyz="0.15315 0 0.0086"
      rpy="0 0 0"/>

  </joint>


  <link name="sim_camera_link">

    <visual>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>

      <material name="camera_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>

    </visual>

    <collision>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>

    </collision>

    <inertial>

      <mass value="0.001"/>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <inertia
        ixx="0.000001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000001"
        iyz="0.0"
        izz="0.000001"/>

    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- RGB CAMERA                                                -->
  <!-- ========================================================= -->

  <joint name="sim_camera_color_joint" type="fixed">

    <parent link="sim_camera_link"/>
    <child link="sim_camera_color_frame"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

  </joint>

  <link name="sim_camera_color_frame"/>


  <joint name="sim_camera_color_optical_joint" type="fixed">

    <parent link="sim_camera_color_frame"/>
    <child link="sim_camera_color_optical_frame"/>

    <origin
      xyz="0 0 0"
      rpy="${-M_PI/2} 0 ${-M_PI/2}"/>

  </joint>

  <link name="sim_camera_color_optical_frame"/>


  <!-- ========================================================= -->
  <!-- RGB CAMERA SENSOR                                         -->
  <!-- ========================================================= -->

  <gazebo reference="sim_camera_color_frame">

    <sensor
      name="sim_rgb_camera"
      type="camera">

      <always_on>true</always_on>

      <visualize>true</visualize>

      <update_rate>30</update_rate>

      <topic>/camera/color/image_raw</topic>

      <camera_info_topic>/camera/color/camera_info</camera_info_topic>

      <gz_frame_id>sim_camera_color_optical_frame</gz_frame_id>

      <camera>

        <!-- RealSense D435 approximate horizontal FOV -->
        <horizontal_fov>1.5184</horizontal_fov>

        <image>

          <width>640</width>

          <height>480</height>

          <format>R8G8B8</format>

        </image>

        <clip>

          <near>0.05</near>
          <far>20.0</far>

        </clip>

      </camera>

    </sensor>

  </gazebo>



  <!-- ========================================================= -->
  <!-- DEPTH CAMERA                                              -->
  <!-- ========================================================= -->

  <joint name="sim_camera_depth_joint" type="fixed">

    <parent link="sim_camera_link"/>
    <child link="sim_camera_depth_frame"/>

    <!-- D435 depth camera is slightly offset from RGB -->
    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

  </joint>

  <link name="sim_camera_depth_frame"/>


  <joint name="sim_camera_depth_optical_joint" type="fixed">

    <parent link="sim_camera_depth_frame"/>
    <child link="sim_camera_depth_optical_frame"/>

    <origin
      xyz="0 0 0"
      rpy="${-M_PI/2} 0 ${-M_PI/2}"/>

  </joint>

  <link name="sim_camera_depth_optical_frame"/>


  <!-- ========================================================= -->
  <!-- DEPTH CAMERA SENSOR                                       -->
  <!-- ========================================================= -->

  <gazebo reference="sim_camera_depth_frame">

    <sensor
      name="sim_depth_camera"
      type="depth_camera">

      <always_on>true</always_on>

      <visualize>true</visualize>

      <update_rate>30</update_rate>

      <topic>/camera/depth/image_raw</topic>

      <camera_info_topic>/camera/depth/camera_info</camera_info_topic>

      <gz_frame_id>sim_camera_depth_optical_frame</gz_frame_id>

      <camera>

        <horizontal_fov>1.5184</horizontal_fov>

        <image>

          <width>640</width>

          <height>480</height>

          <!-- Gazebo depth image -->
          <format>R_FLOAT32</format>

        </image>

        <clip>

          <near>0.05</near>
          <far>20.0</far>

        </clip>

      </camera>

    </sensor>

  </gazebo>



  <!-- ========================================================= -->
  <!-- INFRARED CAMERA                                           -->
  <!-- ========================================================= -->

  <joint name="sim_camera_infra1_joint" type="fixed">

    <parent link="sim_camera_link"/>
    <child link="sim_camera_infra1_frame"/>

    <!-- Approximate D435 IR position -->
    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

  </joint>

  <link name="sim_camera_infra1_frame"/>


  <joint name="sim_camera_infra1_optical_joint" type="fixed">

    <parent link="sim_camera_infra1_frame"/>
    <child link="sim_camera_infra1_optical_frame"/>

    <origin
      xyz="0 0 0"
      rpy="${-M_PI/2} 0 ${-M_PI/2}"/>

  </joint>

  <link name="sim_camera_infra1_optical_frame"/>


  <!-- ========================================================= -->
  <!-- INFRARED CAMERA SENSOR                                    -->
  <!-- ========================================================= -->

  <gazebo reference="sim_camera_infra1_frame">

    <sensor
      name="sim_infrared_camera"
      type="camera">

      <always_on>true</always_on>

      <visualize>true</visualize>

      <update_rate>30</update_rate>

      <topic>/camera/infra1/image_raw</topic>

      <camera_info_topic>/camera/infra1/camera_info</camera_info_topic>

      <gz_frame_id>sim_camera_infra1_optical_frame</gz_frame_id>

      <camera>

        <horizontal_fov>1.5184</horizontal_fov>

        <image>

          <width>640</width>

          <height>480</height>

          <!-- Grayscale image -->
          <format>L8</format>

        </image>

        <clip>

          <near>0.05</near>
          <far>20.0</far>

        </clip>

      </camera>

    </sensor>

  </gazebo>



  <!-- ========================================================= -->
  <!-- IMU                                                       -->
  <!-- ========================================================= -->

  <joint name="sim_camera_imu_joint" type="fixed">

    <parent link="sim_camera_link"/>
    <child link="sim_camera_imu_frame"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

  </joint>

  <link name="sim_camera_imu_frame"/>


  <!-- ========================================================= -->
  <!-- IMU SENSOR                                                 -->
  <!-- Gazebo Fortress                                           -->
  <!-- ========================================================= -->

  <gazebo reference="sim_camera_imu_frame">

    <sensor
      name="sim_realsense_imu"
      type="imu">

      <always_on>true</always_on>

      <update_rate>200</update_rate>

      <visualize>true</visualize>

      <topic>/camera/imu</topic>

      <gz_frame_id>sim_camera_imu_frame</gz_frame_id>

      <imu>

        <!-- =================================================== -->
        <!-- Angular velocity                                    -->
        <!-- =================================================== -->

        <angular_velocity>

          <x>
            <noise type="gaussian">

              <mean>0.0</mean>
              <stddev>0.002</stddev>

              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.0</bias_stddev>

              <dynamic_bias_stddev>0.0</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>

            </noise>
          </x>

          <y>
            <noise type="gaussian">

              <mean>0.0</mean>
              <stddev>0.002</stddev>

              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.0</bias_stddev>

              <dynamic_bias_stddev>0.0</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>

            </noise>
          </y>

          <z>
            <noise type="gaussian">

              <mean>0.0</mean>
              <stddev>0.002</stddev>

              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.0</bias_stddev>

              <dynamic_bias_stddev>0.0</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>

            </noise>
          </z>

        </angular_velocity>


        <!-- =================================================== -->
        <!-- Linear acceleration                                 -->
        <!-- =================================================== -->

        <linear_acceleration>

          <x>
            <noise type="gaussian">

              <mean>0.0</mean>
              <stddev>0.01</stddev>

              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.0</bias_stddev>

              <dynamic_bias_stddev>0.0</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>

            </noise>
          </x>

          <y>
            <noise type="gaussian">

              <mean>0.0</mean>
              <stddev>0.01</stddev>

              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.0</bias_stddev>

              <dynamic_bias_stddev>0.0</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>

            </noise>
          </y>

          <z>
            <noise type="gaussian">

              <mean>0.0</mean>
              <stddev>0.01</stddev>

              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.0</bias_stddev>

              <dynamic_bias_stddev>0.0</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>

            </noise>
          </z>

        </linear_acceleration>

      </imu>

    </sensor>

  </gazebo>

</robot>
