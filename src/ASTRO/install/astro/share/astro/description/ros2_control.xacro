<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <!-- IZMJENA: prije L/D limite nisu bili isti (15.87 vs 16.76),
             pa pri vožnji unazad jedan kotač saturira ranije -> lažno skretanje.
             20.9 rad/s = max_wheel_angular_velocity iz astro_serial.cpp -->
        <joint name="left_wheel_joint">
            <command_interface name="velocity"> 
                <param name="min">-15.9</param>
                <param name="max">15.9</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="right_wheel_joint">
            <command_interface name="velocity"> 
                <param name="min">-16.7</param>
                <param name="max">16.7</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
		<parameters>$(find astro)/config/diff_drive_controller.yaml</parameters>
        </plugin>
    </gazebo>

</robot>
